<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Receive commands from the iPhone, and expand shared map links. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed on Android 17 and newer to talk to the iPhone on the hotspot network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Keep the command listener running in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required before Android 14+ allows a "connected device" background service. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- "Display over other apps": lets the app open Google Maps while it's in the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <!-- No backups. allowBackup="false" covers Android 8-11, and the extraction rules cover Android 12+,
         where allowBackup alone no longer stops device-to-device transfer. Lint wants fullBackupContent too,
         but with backup turned off that would change nothing. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BikeLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Has no screen of its own: wakes and unlocks the phone, opens Google Maps, then closes. -->
        <activity
            android:name=".LaunchMapsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BikeLink.Invisible" />

        <service
            android:name=".BikeLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".MapsHelperService"
            android:exported="true"
            android:label="@string/maps_helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/maps_helper" />
        </service>

        <!-- Both are protected broadcasts: only the system can send them. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
