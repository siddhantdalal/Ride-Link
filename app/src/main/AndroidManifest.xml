<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Receive commands from the iPhone, and expand shared map links. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the screen update its status live when the phone joins or leaves the iPhone hotspot. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed on Android 17 and newer to talk to the iPhone on the hotspot network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Keep the command listener running in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required before Android 14+ allows a "connected device" background service. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- "Display over other apps": lets the ride screen open when a destination arrives in the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Calls and music from the iPhone over Bluetooth Low Energy: advertising so the iPhone can pair, then
         connecting to Apple's notification and media services. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Turn-by-turn navigation needs precise location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- No backups. allowBackup="false" covers Android 8-11, and the extraction rules cover Android 12+,
         where allowBackup alone no longer stops device-to-device transfer. Lint wants fullBackupContent too,
         but with backup turned off that would change nothing. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BikeLink">

        <!-- The Google Maps Platform key, filled in at build time from secrets.properties (never committed). It only
             works from this app's package and signing certificate, and only for the Navigation SDK. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- The car screen. One instance: a destination from the iPhone goes to the open one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Google's turn-by-turn feed for the Dashboard's next-turn card. The Navigation SDK binds to it in-process. -->
        <service
            android:name=".NavInfoService"
            android:exported="false" />

        <service
            android:name=".BikeLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Both are protected broadcasts: only the system can send them. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
