<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light ("day") palette. The dark palette is in values-night, and Android switches between them with the phone's
         dark theme setting. Text colours meet WCAG AA contrast (4.5:1) on the surfaces they sit on. -->
    <color name="bg_top">#F7F8FA</color>
    <color name="bg_bottom">#ECEFF3</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_raised">#EDF0F4</color>
    <color name="surface_stroke">#DCE1E7</color>

    <color name="text_primary">#11161C</color>
    <color name="text_secondary">#56606C</color>

    <color name="accent">#0A8545</color>
    <color name="on_accent">#FFFFFF</color>

    <color name="status_warning">#A35F00</color>
    <color name="status_idle">#8A939E</color>
    <color name="danger">#D93025</color>

    <!-- One colour each for calls and music, used on the bars over Google Maps and on the status screen. -->
    <color name="calls">#0873B8</color>
    <color name="music">#7357D6</color>

    <!-- The bars floating over Google Maps: nearly opaque, so they stay readable in sunlight. -->
    <color name="glass_top">#F5FFFFFF</color>
    <color name="glass_bottom">#F2F3F5F8</color>
    <color name="glass_stroke">#1F000000</color>
    <!-- Dims the map behind the incoming-call capsule (35%), so the call stands out but the map stays visible. -->
    <color name="scrim">#59000000</color>
    <color name="ripple">#1F000000</color>

    <!-- The launcher icon's background. The same in both themes. -->
    <color name="icon_background">#1E8E3E</color>
</resources>
