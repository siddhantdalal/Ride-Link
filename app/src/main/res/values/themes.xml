<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material theme: no AndroidX/Material libraries are needed for two small screens. -->
    <style name="Theme.BikeLink" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- For LaunchMapsActivity, which never draws anything. -->
    <style name="Theme.BikeLink.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
