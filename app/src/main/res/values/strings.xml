    <string name="maps_helper_label">Bike Link – Maps helper</string>
    <string name="maps_helper_description">Taps Google Maps\' \"Yes\" button when you send a new destination mid-ride, and \"Close navigation\" when you send Stop Ride. It only acts for a few seconds after a command from your iPhone, only inside Google Maps, and reads nothing else.</string>

