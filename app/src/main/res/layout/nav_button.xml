<?xml version="1.0" encoding="utf-8"?>
<!-- A sidebar or bottom-bar button: an icon with a label underneath. Its id, size and the highlight for the open
     screen come from where it's used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nav_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/nav_button_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/nav_button_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textSize="11sp" />
</LinearLayout>
