<?xml version="1.0" encoding="utf-8"?>
<!-- Ride block: during a free ride, offers the last destination again. It's glove-sized and full width, and tapping it
     is the only way a free ride requests (and counts) a route. -->
<Button xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ride_again"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_pill"
    android:ellipsize="end"
    android:fontFamily="@font/space_grotesk"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp"
    android:singleLine="true"
    android:stateListAnimator="@null"
    android:textAllCaps="false"
    android:textColor="@color/on_accent"
    android:textSize="18sp"
    android:textStyle="bold"
    android:visibility="gone" />
