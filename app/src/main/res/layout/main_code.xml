<?xml version="1.0" encoding="utf-8"?>
<!-- The bike code and this phone's address, which the iPhone Shortcuts ask for once, plus About & licences. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:text="@string/bike_code_label"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/bike_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/space_grotesk"
        android:letterSpacing="0.08"
        android:textColor="@color/accent"
        android:textIsSelectable="true"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/bike_code_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/bike_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="14sp" />

    <Button
        android:id="@+id/about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_text_button"
        android:minHeight="56dp"
        android:paddingHorizontal="12dp"
        android:stateListAnimator="@null"
        android:text="@string/about_licences"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
