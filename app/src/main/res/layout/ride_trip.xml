<?xml version="1.0" encoding="utf-8"?>
<!-- Ride block: time and distance left, arrival time, and End ride. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trip_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:textColor="@color/accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trip_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Glove-sized, and tinted rather than solid red, so it reads as available but not urgent. -->
    <ImageButton
        android:id="@+id/end_ride"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_round_button"
        android:backgroundTint="#33FF5A4E"
        android:contentDescription="@string/end_ride"
        android:scaleType="center"
        android:src="@drawable/ic_close"
        android:tint="@color/danger" />
</LinearLayout>
