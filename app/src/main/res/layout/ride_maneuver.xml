<?xml version="1.0" encoding="utf-8"?>
<!-- Ride block: the next turn, the brightest thing on screen so it can be read at speed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_maneuver"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="18dp">

    <ImageView
        android:id="@+id/maneuver_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:importantForAccessibility="no"
        android:tint="@color/on_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/maneuver_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:textColor="@color/on_accent"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/maneuver_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/on_accent"
            android:textSize="19sp" />
    </LinearLayout>
</LinearLayout>
