<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom bar in portrait: the same status and buttons as the landscape sidebar, laid out like a phone's tab
     bar, with labels. Buttons are about 64dp square, easy to hit with gloves. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/bg_nav_rail"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">

        <include
            layout="@layout/nav_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <include
        android:id="@+id/nav_map"
        layout="@layout/nav_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/nav_music"
        layout="@layout/nav_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/nav_calls"
        layout="@layout/nav_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/nav_toggle"
        layout="@layout/nav_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1" />
</LinearLayout>
