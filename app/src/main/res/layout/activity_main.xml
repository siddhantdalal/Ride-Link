<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard, portrait. Like CarPlay, it never scrolls: everything fits one screen, and the gauge takes whatever
     height is left after the clock and the tiles. Landscape is in layout-land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/dashboard_clock" />

    <include
        layout="@layout/dashboard_gauge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/status_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- The tiles, with the iPhone's incoming call shown over them while it rings. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="272dp"
        android:layout_marginTop="14dp">

        <include
            layout="@layout/dashboard_tiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/ride_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
