<?xml version="1.0" encoding="utf-8"?>
<!-- The car screen, portrait. Like CarPlay, it never scrolls. Here the CarPlay sidebar becomes a bottom bar.
     - Dashboard: the live map, with the next-turn card floating at its top, and the now-playing and trip cards below.
     - Map: the full map with Google's own turn banner and a trip card.
     - Music, Calls, Home: full screens over the map. The map keeps running underneath, so guidance never stops.
     - An incoming call shows as a compact bar over whichever screen is open.
     Landscape is in layout-land. -->
<!-- The music controls appear twice (the Dashboard card and the Music screen) on purpose: each card looks up its
     views inside its own root, so the repeated ids never collide. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:ignore="DuplicateIncludedIds"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.google.android.libraries.navigation.NavigationView
                    android:id="@+id/navigation_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/dash_turn"
                    layout="@layout/card_turn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_margin="10dp" />

                <include
                    layout="@layout/ride_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp" />

                <include
                    android:id="@+id/map_trip"
                    layout="@layout/card_trip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="10dp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dashboard_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <include
                    android:id="@+id/dash_music"
                    layout="@layout/card_music" />

                <include
                    android:id="@+id/dash_trip"
                    layout="@layout/card_trip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/pane_music"
            layout="@layout/pane_music"
            android:visibility="gone" />

        <include
            android:id="@+id/pane_calls"
            layout="@layout/pane_calls"
            android:visibility="gone" />

        <include
            android:id="@+id/pane_home"
            layout="@layout/pane_home"
            android:visibility="gone" />

        <include
            android:id="@+id/call_bar"
            layout="@layout/card_call_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/nav_bar" />
</LinearLayout>
