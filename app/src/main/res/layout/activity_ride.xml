<?xml version="1.0" encoding="utf-8"?>
<!-- Ride screen, portrait: turn card at the top, map in the middle, trip and dock at the bottom. The dock shows one
     card at a time: an incoming call replaces the music card until it's answered or declined.
     Merged into the window's own frame: the map fills it, and the ride UI sits on top. Landscape is in layout-land. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Google's navigation map replaces this stand-in later. -->
    <com.siddhantdalal.bikelink.RoutePlaceholderView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="14dp">

        <include layout="@layout/ride_maneuver" />

        <TextView
            android:id="@+id/preview_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_preview_banner"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:singleLine="true"
            android:text="@string/preview_banner"
            android:textColor="@color/status_warning"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/ride_trip" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <include layout="@layout/ride_music" />

            <include layout="@layout/ride_call" />
        </FrameLayout>
    </LinearLayout>
</merge>
