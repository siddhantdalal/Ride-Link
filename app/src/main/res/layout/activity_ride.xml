<?xml version="1.0" encoding="utf-8"?>
<!-- Ride screen, portrait: Google's navigation (map, next-turn header, speedometer) on top, and Bike Link's trip strip
     and dock below it. They sit side by side rather than overlapping, so Google's on-map controls are never covered.
     Landscape is in layout-land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.libraries.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <include layout="@layout/ride_banner" />

        <include layout="@layout/ride_again" />

        <include layout="@layout/ride_trip" />

        <!-- Music and calls arrive with the Bluetooth link to the iPhone. Until then these stay hidden. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                layout="@layout/ride_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <include
                layout="@layout/ride_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
