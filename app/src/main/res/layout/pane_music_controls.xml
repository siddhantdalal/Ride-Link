<?xml version="1.0" encoding="utf-8"?>
<!-- The Music screen's track and controls, shared by both orientations. The ids match card_music.xml, so the same
     code drives both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/music_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/music_previous"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_round_button"
            android:backgroundTint="@color/surface_raised"
            android:contentDescription="@string/previous_track"
            android:scaleType="center"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/music_play"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_round_button"
            android:backgroundTint="@color/tile_music"
            android:contentDescription="@string/play_pause"
            android:scaleType="center"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/bg_bottom" />

        <ImageButton
            android:id="@+id/music_next"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_round_button"
            android:backgroundTint="@color/surface_raised"
            android:contentDescription="@string/next_track"
            android:scaleType="center"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
