<?xml version="1.0" encoding="utf-8"?>
<!-- Ride screen, landscape (phone mounted sideways). The map fills the whole screen, and Bike Link's cards float in the
     bottom-right corner, sized to their content. That keeps them clear of Google's next-turn header (top left) and
     its speedometer and re-centre button (bottom left), and never leaves a blank column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.libraries.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <include layout="@layout/ride_banner" />

        <!-- Music and calls arrive with the Bluetooth link to the iPhone. Until then these stay hidden. -->
        <include
            layout="@layout/ride_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <include
            layout="@layout/ride_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <include layout="@layout/ride_again" />

        <include layout="@layout/ride_trip" />
    </LinearLayout>
</FrameLayout>
