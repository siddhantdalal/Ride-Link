<?xml version="1.0" encoding="utf-8"?>
<!-- A sidebar button in landscape: icon only, like CarPlay's sidebar. The label still serves as its spoken name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nav_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/nav_button_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/nav_button_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
