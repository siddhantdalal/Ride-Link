<?xml version="1.0" encoding="utf-8"?>
<!-- The bike code is a secret for this phone only, so it's never backed up or copied to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
