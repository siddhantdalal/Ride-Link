<?xml version="1.0" encoding="utf-8"?>
<!-- A frosted card that floats over the map, after CarPlay's Liquid Glass panels: mostly opaque, so text stays
     readable in sunlight, with a lighter top edge and a fine highlight border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="#E60C1210"
        android:startColor="#E61A2420" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
