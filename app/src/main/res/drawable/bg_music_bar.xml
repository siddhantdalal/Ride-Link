<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing bar over Google Maps: a frosted pill with a fine edge, so it reads on any map colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="999dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/glass_bottom"
        android:startColor="@color/glass_top" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
