<?xml version="1.0" encoding="utf-8"?>
<!-- The incoming-call bar: frosted like the other cards, with a calls-blue edge so it stands out the moment it rings. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="26dp" />
    <gradient
        android:angle="270"
        android:endColor="#F20C1210"
        android:startColor="#F21A2420" />
    <stroke
        android:width="2dp"
        android:color="#994FC3F7" />
</shape>
